<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ModShardLauncher.GUI.Services"
        x:Class="ModShardLauncher.GUI.Views.ErrorDialog"
        Width="640" Height="440"
        MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False">

  <Grid Margin="18" RowDefinitions="Auto,Auto,*,Auto">

    <TextBlock Name="TitleText" Classes="h2" TextWrapping="Wrap" />
    <TextBlock Name="MessageText" Grid.Row="1" Classes="subtitle" Margin="0,8,0,0" TextWrapping="Wrap" />

    <Border Name="DetailsBorder" Grid.Row="2" Classes="card" Margin="0,14,0,14" Padding="10">
      <ScrollViewer>
        <SelectableTextBlock Name="DetailsText" FontFamily="Consolas" FontSize="11"
                             Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto">
      <Button Content="{loc:Tr DialogOpenLogs}" Click="OpenLogs_Click" Classes="ghost" />
      <Button Grid.Column="2" Content="{loc:Tr DialogCopy}" Click="Copy_Click" Margin="8,0,0,0" />
      <Button Grid.Column="3" Content="{loc:Tr DialogClose}" Click="Close_Click" Classes="primary" Margin="8,0,0,0" />
    </Grid>

  </Grid>
</Window>
